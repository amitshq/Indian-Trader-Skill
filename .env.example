# Copy to .env if you use one; none of these are required for paper trading.
# NEVER commit real values. Tokens/keys are read from the environment only.

# Prices: leave unset for in-memory demo prices, or yfinance for delayed unofficial quotes
QUOTES=
# Fundamentals source for the API: verified | nse | yahoo | (unset = bundled SYNTHETIC sample data)
FUNDAMENTALS=
# Symbols for live fundamentals (default: config/universe.json)
SYMBOLS=
# Your own results file instead of the sample (JSON or CSV)
FUNDAMENTALS_PATH=

# --- Live trading (OFF by default; read README "Live trading with Upstox" first) ---
BROKER=
UPSTOX_API_KEY=
UPSTOX_API_SECRET=
UPSTOX_REDIRECT_URI=http://localhost:8000/api/live/callback
# Daily access token if you obtain one yourself (expires every day)
UPSTOX_ACCESS_TOKEN=
# Must equal I_UNDERSTAND_THIS_USES_REAL_MONEY, and config/live.json live_enabled must be true
INDIA_TRADER_LIVE=
